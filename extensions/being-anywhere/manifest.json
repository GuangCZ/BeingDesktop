{
  "manifest_version": 3,
  "name": "BeingAnywhere",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "把网页选区带给你的 Being，在小浮窗中提问，在侧栏继续对话。",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "BeingAnywhere",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/being-16.png",
      "32": "icons/being-32.png",
      "48": "icons/being-48.png",
      "128": "icons/being-128.png"
    }
  },
  "icons": {
    "16": "icons/being-16.png",
    "32": "icons/being-32.png",
    "48": "icons/being-48.png",
    "128": "icons/being-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "open-being": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "在 Being 侧栏中处理选区"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "floating.html",
        "icons/being-small.svg",
        "icons/being-*.png"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
